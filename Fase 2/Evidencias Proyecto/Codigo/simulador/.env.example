# Simulador de funcionarios (copiar a simulador/.env)
# Host público de Redis: el mismo REDIS_HOST del worker-service (balanceador NLB de AWS).
# Sin él, los paneles ven el movimiento solo con su refresco automático (20 a 60 s).
REDIS_HOST=

# Opcionales: si se dejan vacíos se toman de munivox-lambda/.env (DATABASE_URL)
# y de munivox-dashboard/.env.local (NEXT_PUBLIC_MAPBOX_TOKEN).
DATABASE_URL=
MAPBOX_TOKEN=
