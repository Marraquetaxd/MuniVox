# worker-service: conversación con el vecino, IA (Gemini) y creación de reportes
REDIS_HOST=localhost
DATABASE_URL=postgresql://usuario:contrasena@host:5432/postgres?schema=public
GEMINI_API_KEY=clave-de-google-gemini
AWS_ACCESS_KEY_ID=clave-de-acceso-aws
AWS_SECRET_ACCESS_KEY=secreto-aws
AWS_REGION=us-east-2
AWS_S3_BUCKET_NAME=munivox-evidencias-mvp
META_PHONE_ID=id-del-numero-de-whatsapp
META_ACCESS_TOKEN=token-de-meta
# Opcionales
GEMINI_MODEL=gemini-3.5-flash-lite
ESPERA_CONSOLIDACION_MS=2500
MINUTOS_ABANDONO=30
TOLERANCIA_LIMITE_M=150
PANEL_URL=https://dominio-del-dashboard
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:correo@municipalidad.cl
# Si se define, borra relato y fotos de casos cerrados hace más de N meses
RETENCION_MESES=
